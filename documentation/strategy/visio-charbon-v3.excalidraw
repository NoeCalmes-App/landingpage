"angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["nfb0c046d96"], "frameId": null, "roundness": null, "seed": 1406694217, "version": 1, "versionNonce": 1374208797, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false, "text": "Pourquoi j'obtiens des rendez-vous : je casse le marché", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Pourquoi j'obtiens des rendez-vous : je casse le marché", "autoResize": true, "lineHeight": 1.25}, {"id": "n5eceb0c71e", "type": "text", "x": 18, "y": 2287.75, "width": 1206.9, "height": 18.75, "angle": 0, "strokeColor": "#45454f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["nfb0c046d96"], "frameId": null, "roundness": null, "seed": 2058278587, "version": 1, "versionNonce": 167435848, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false, "text": "Audit gratuit, conseils gratuits, maquette sur mesure + cahier des charges + devis offerts. Et je suis honnête : ils le sentent et me font confiance.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Audit gratuit, conseils gratuits, maquette sur mesure + cahier des charges + devis offerts. Et je suis honnête : ils le sentent et me font confiance.", "autoResize": true, "lineHeight": 1.25}, {"id": "n32af3aeaa3", "type": "rectangle", "x": -40, "y": 2460, "width": 1880, "height": 350, "angle": 0, "strokeColor": "#c9c4ee", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 428082446, "version": 1, "versionN