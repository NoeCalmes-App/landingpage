t", "verticalAlign": "top", "containerId": null, "originalText": "Bien reçu, je te réponds dans la\njournée. Dis-moi ton idée en deux\nphrases : c'est quoi, et pour qui ?", "autoResize": true, "lineHeight": 1.25}, {"id": "n7670c61508", "type": "rectangle", "x": 1520, "y": 1230, "width": 260, "height": 148, "angle": 0, "strokeColor": "#d9fdd3", "backgroundColor": "#d9fdd3", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ndbdf007dfa"], "frameId": null, "roundness": {"type": 3}, "seed": 1800385931, "version": 1, "versionNonce": 1162329463, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false}, {"id": "n841572c073", "type": "text", "x": 1532, "y": 1238, "width": 199.8, "height": 12.5, "angle": 0, "strokeColor": "#6b7c74", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ndbdf007dfa"], "frameId": null, "roundness": null, "seed": 1611064094, "version": 1, "versionNonce": 1104947563, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false, "text": "MON 1ER MESSAGE (APRÈS LE FORMULAIRE)", "fontSize": 10, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "MON 1ER MESSAGE (APRÈS LE FORMULAIRE)", "autoResize": true, "lineHeight": 1.25}, {"id": "n4f07a04e64", "type": "text", "x": 1532, "y": 1256, "width": 266.76, "height": 97.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ndbdf007dfa"], "frameId": null, "roundness": null, "seed": 1291250280, "version": 1, "versionNonce": 188403557, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false, "text": "Bonjour {prénom}, ici Noé Calmes.\nJ'ai bien reçu ton idée d'application.\nJe te propose un audit gratuit,\n15 min par téléphone : mes conseils,\net à la fin combien ça coûterait.\nQuand es-tu disponible ?", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Bonjour {prénom}, ici Noé Calmes.\nJ'ai bien reçu ton idée d'application.\nJe te propose un audit gratuit,\n15 min par téléphone : mes conseils,\net à la fin combien ça coûterait.\nQuand es-tu disponible ?", "autoResize": true, "lineHeight": 1.25}, {"id": "n057b1ffc6a", "type": "rectangle", "x": -40, "y": 1890, "width": 1880, "height": 510, "angle": 0, "strokeColor": "#c9c4ee", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 494397207, "version": 1, "versionNonce": 2055991745, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false}, {"id": "n1cb2c60fdd", "type": "text", "x": -10, "y": 1900, "width": 283.5, "height": 18.75, "angle": 0, "strokeColor": "#6c5ce7", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1067837481, "version": 1, "versionNonce": 1674921593, "isDeleted": false, "boundElements": null, "updated": 1794300000000, "link": null, "locked": false, "text": "3 · CE QUE JE FAIS AVEC UN PROSPECT", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3 · CE QUE JE FAIS AVEC UN PROSPECT", "autoResize": true, "lineHeight": 1.25}, {"id": "na89d5015e5", "type": "text", "x": 0, "y": 1940, "width": 725.76, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, 