# Copier ce fichier en .env.local et remplacer la valeur après déploiement
# de la Cloud Function chatbot (cf. devis-app/functions/chatbot/README.md).
# .env.local est ignoré par git.
VITE_CHATBOT_API_URL=https://chatbot-XXXXX-ew.a.run.app

# Jeton PUBLIC Mapbox (pk.…) pour /charte/smoothride et /maquette/smoothride.
# Jamais un jeton secret (sk.…). A restreindre par URL dans la console Mapbox.
# A creer sur https://account.mapbox.com/access-tokens/ (gratuit).
VITE_MAPBOX_TOKEN=pk.remplacer_par_votre_token
